# Credenciais do PGSQL
DB_USER=dspace
DB_PASSWORD=
DB_NAME=dspace

# Hostname/identificação/IPs confiáveis
DSPACE_HOSTNAME=testedspace.ufjf.br
DSPACE_NAME=Repositório Institucional UFJF
DSPACE_TRUSTED_IP_RANGES=172.23.0.0/24

# Funcionalidades
LDN_ENABLED=true
DSPACE_UI_BINDHOST=0.0.0.0

# Timezone
TZ=America/Sao_Paulo

# Config nginx
NGINX_DIR=/docker/dspace-docker/nginx

# Dumps para restaurar
DB_INIT_SQL_63=/home/repositorio/dspace_63_alterado.sql
DB_INIT_SQL=/home/repositorio/dspace_76.sql

# Scripts de inicialização do banco
INITDB_DIR=/docker/dspace-docker/initdb

# Customizações do dspace-ui
DSPACE_UI_DIR=/docker/dspace-docker/dspace-ui

# Customizações do dspace
DSPACE_DIR=/docker/dspace-docker/dspace

# Volumes
POSTGRES7_DATA=/docker/volumes/dspace7/postgresql
POSTGRES_DATA=/docker/volumes/dspace/postgresql
SOLR_DATA=/docker/volumes/dspace/solr
ASSETSTORE=/home/repositorio/assetstore
